# Copialo como .env y completalo

# API-Football: registrate en https://www.api-football.com/
# Plan FREE: 100 requests/día
API_FOOTBALL_KEY=tu_api_key_aca

# DB local. En Railway lo inyecta solo al linkear el plugin Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/futstats

# Temporada actual (chequear que coincida con la que está corriendo)
SEASON=2025

# Cada cuántas horas sincronizar (con plan free, mejor cada 8-12h)
SYNC_INTERVAL_HOURS=8
